---------------------------------------------------------------- модель пушки
local function buildGun()
	local model = Instance.new("Model")
	model.Name = "LocalPortalGun"

	local function setup(p)
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
	end

	local root = Instance.new("Part")
	root.Name = "GunRoot"
	root.Size = V(0.2, 0.2, 0.2)
	root.Transparency = 1
	setup(root)
	root.Parent = model

	local gripWeld = Instance.new("Weld")
	gripWeld.Part1 = root
	gripWeld.Parent = root

	local function add(name, size, cf, color, material, shape, tr)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.Transparency = tr or 0
		if shape then
			p.Shape = shape
		end
		setup(p)
		local w = Instance.new("Weld")
		w.Part0 = root
		w.Part1 = p
		w.C0 = cf
		w.Parent = p
		p.Parent = model
		return p, w
	end

	local CYL = Enum.PartType.Cylinder
	local BALL = Enum.PartType.Ball
	local UP = CFrame.Angles(0, 0, math.rad(90)) -- цилиндр стоймя

	local function cylV(name, h, d, pos, color, mat, tr)
		return add(name, V(h, d, d), CFrame.new(pos) * UP, color, mat, CYL, tr)
	end

	-- корпус, перёд, рукоятка
	add("Body", V(0.62, 0.42, 1.1), CFrame.new(0, 0.1, -0.55), LIGHT)
	add("BodyFront", V(0.5, 0.34, 0.3), CFrame.new(0, 0.08, -1.25), LIGHT2)
	add("Handle", V(0.3, 0.32, 1.0), CFrame.new(0, -0.1, 0.5) * CFrame.Angles(math.rad(20), 0, 0), LIGHT)
	add("HandleEnd", V(0.34, 0.34, 0.34), CFrame.new(0, -0.27, 0.97), LIGHT, nil, BALL)
	add("RailL", V(0.05, 0.12, 0.95), CFrame.new(-0.33, 0.02, -0.5), GREYD)
	add("RailR", V(0.05, 0.12, 0.95), CFrame.new(0.33, 0.02, -0.5), GREYD)

	-- красный дисплей и чёрная ручка
	add("Bezel", V(0.3, 0.04, 0.46), CFrame.new(0, 0.33, -0.4), GREYD)
	add("Display", V(0.2, 0.05, 0.34), CFrame.new(0, 0.345, -0.4), RED, Enum.Material.Neon, nil, 0.1)
	cylV("Knob", 0.12, 0.22, V(0, 0.37, -0.08), BLACK, Enum.Material.SmoothPlastic)

	-- зелёный купол с энергией
	cylV("DomeBase", 0.14, 0.62, V(0, 0.38, -0.85), LIGHT2)
	local dome = cylV("DomeGlass", 0.55, 0.42, V(0, 0.725, -0.85), GREEN, Enum.Material.Neon, 0.2)
	add("DomeTop", V(0.42, 0.42, 0.42), CFrame.new(0, 1.0, -0.85), GREEN, Enum.Material.Neon, BALL, 0.2)
	local core = cylV("DomeCore", 0.5, 0.22, V(0, 0.725, -0.85), Color3.fromRGB(205, 255, 150), Enum.Material.Neon, 0.1)

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(110, 255, 90)
	light.Range = 9
	light.Brightness = 1.2
	light.Shadows = false
	light.Parent = core

	local em = Instance.new("ParticleEmitter")
	em.Rate = 30
	em.Lifetime = NumberRange.new(0.5, 0.9)
	em.Speed = NumberRange.new(0.2, 0.5)
	em.SpreadAngle = Vector2.new(180, 180)
	em.RotSpeed = NumberRange.new(-180, 180)
	em.Size = NumberSequence.new(0.12, 0)
	em.LightEmission = 1
	em.Color = ColorSequence.new(Color3.fromRGB(235, 255, 210), LIME)
	em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	em.Parent = core

	-- две «искры», кружащие внутри купола
	local specks = {}
	for i = 1, 2 do
		local p, w = add("Speck", V(0.07, 0.07, 0.07), CFrame.new(0, 0.725, -0.85), Color3.new(1, 1, 1),
			Enum.Material.Neon, BALL)
		specks[i] = { weld = w, ph = (i - 1) * math.pi }
	end

	return { model = model, root = root, weld = gripWeld, dome = dome, light = light, specks = specks, baseC0 = CFrame.new() }
end
