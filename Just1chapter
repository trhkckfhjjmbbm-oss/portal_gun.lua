local function styleButton(b, round)
	b.BackgroundColor3 = Color3.fromRGB(16, 22, 16)
	b.BackgroundTransparency = 0.1
	b.BorderSizePixel = 0
	b.Font = Enum.Font.GothamBold
	b.TextColor3 = Color3.fromRGB(190, 255, 160)
	local c = Instance.new("UICorner")
	c.CornerRadius = round and UDim.new(1, 0) or UDim.new(0, 8)
	c.Parent = b
	local s = Instance.new("UIStroke")
	s.Color = LIME
	s.Thickness = 1.4
	s.Transparency = 0.3
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = b
end

local function mkButton(label, order, onClick)
	local b = Instance.new("TextButton")
	b.LayoutOrder = order
	b.Size = UDim2.new(1, 0, 0, 36)
	b.TextSize = 14
	b.Text = label
	styleButton(b, false)
	b.Parent = frame
	b.Activated:Connect(onClick)
	return b
end

